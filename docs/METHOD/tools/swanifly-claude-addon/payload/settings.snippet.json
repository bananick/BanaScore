{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "powershell",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/no-mock-guard.ps1"
            ],
            "timeout": 15,
            "statusMessage": "Checking for mock data..."
          }
        ]
      }
    ]
  }
}
