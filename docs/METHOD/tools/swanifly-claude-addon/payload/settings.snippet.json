{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "powershell",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/no-mock-guard.ps1"
            ],
            "timeout": 15,
            "statusMessage": "Checking for mock data..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/ship-push.sh",
            "timeout": 30,
            "statusMessage": "Auto-pushing committed work..."
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/wip-sync.mjs"
            ],
            "timeout": 30,
            "statusMessage": "Mirroring uncommitted work to GitHub..."
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/session-telemetry.mjs"
            ],
            "timeout": 20,
            "statusMessage": "Logging session telemetry..."
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/land.mjs",
              "--auto",
              "--lane",
              "docs"
            ],
            "timeout": 120,
            "statusMessage": "Landing docs/tooling work on main..."
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/pilotage-refresh.mjs"
            ],
            "timeout": 90,
            "statusMessage": "Refreshing the pilotage dashboard..."
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/chantier-status.mjs"
            ],
            "timeout": 15,
            "statusMessage": "Checking the chantier fiche..."
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/land.mjs",
              "--auto"
            ],
            "timeout": 900,
            "statusMessage": "Landing this conversation on main..."
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "resume",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/flight-deck.mjs",
              "--mode",
              "resume-hook"
            ],
            "timeout": 15,
            "statusMessage": "Preparing Flight Deck..."
          }
        ]
      },
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/flight-deck.mjs",
              "--mode",
              "startup-hook"
            ],
            "timeout": 15,
            "statusMessage": "Listing active work..."
          },
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/branch-sweep.mjs",
              "--apply",
              "--landed-only",
              "--auto"
            ],
            "timeout": 90,
            "statusMessage": "Cleaning integrated branches..."
          }
        ]
      }
    ]
  }
}
